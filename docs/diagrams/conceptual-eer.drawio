<mxGraphModel adaptiveColors="auto" page="1" pageScale="1" pageWidth="2100" pageHeight="2300" grid="1" gridSize="10"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b&gt;Helping Hands - conceptual EER&lt;/b&gt;&lt;br&gt;Earlier proposed core model; existing implementation covers only a subset. Phase 1 extensions below are proposed, not an implemented or final schema." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1900" height="65" as="geometry" /></mxCell><mxCell id="UserAccount" value="&lt;b&gt;UserAccount&lt;/b&gt;&lt;br&gt;May hold multiple roles&lt;br&gt;Can represent recipients&lt;br&gt;Can submit requests" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#f5f8ff;strokeColor=#5677a5;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="340" height="150" as="geometry" /></mxCell><mxCell id="Role" value="&lt;b&gt;Role&lt;/b&gt;&lt;br&gt;Administrator / Coordinator&lt;br&gt;Requester / Recipient representative" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#f5f8ff;strokeColor=#5677a5;" vertex="1" parent="1"><mxGeometry x="530" y="120" width="340" height="150" as="geometry" /></mxCell><mxCell id="Beneficiary" value="&lt;b&gt;Beneficiary&lt;/b&gt;&lt;br&gt;Person or family&lt;br&gt;May have no account" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#f5f8ff;strokeColor=#5677a5;" vertex="1" parent="1"><mxGeometry x="1020" y="120" width="340" height="150" as="geometry" /></mxCell><mxCell id="ReferralRecipient" value="&lt;b&gt;ReferralRecipient&lt;/b&gt;&lt;br&gt;Approved and active before referral&lt;br&gt;Exactly one subtype: Charity or Contributor" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#f5f8ff;strokeColor=#5677a5;" vertex="1" parent="1"><mxGeometry x="1510" y="120" width="340" height="150" as="geometry" /></mxCell><mxCell id="Charity" value="&lt;b&gt;Charity&lt;/b&gt;&lt;br&gt;Organization and registration details" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#f5f8ff;strokeColor=#5677a5;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="340" height="150" as="geometry" /></mxCell><mxCell id="Contributor" value="&lt;b&gt;Contributor&lt;/b&gt;&lt;br&gt;Individual contributor" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#f5f8ff;strokeColor=#5677a5;" vertex="1" parent="1"><mxGeometry x="530" y="420" width="340" height="150" as="geometry" /></mxCell><mxCell id="AssistanceRequest" value="&lt;b&gt;AssistanceRequest&lt;/b&gt;&lt;br&gt;One beneficiary; one submitter&lt;br&gt;Intake may be unclassified or mixed&lt;br&gt;Category, quantity and unit may be absent until allocatable&lt;br&gt;Split parent is non-allocatable" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#f5f8ff;strokeColor=#5677a5;" vertex="1" parent="1"><mxGeometry x="1020" y="420" width="340" height="150" as="geometry" /></mxCell><mxCell id="RequestLink" value="&lt;b&gt;RequestLink&lt;/b&gt;&lt;br&gt;Earlier split-parent/child proposal&lt;br&gt;Phase 1 need mapping awaits design review" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#f5f8ff;strokeColor=#5677a5;" vertex="1" parent="1"><mxGeometry x="1510" y="420" width="340" height="150" as="geometry" /></mxCell><mxCell id="Referral" value="&lt;b&gt;Referral&lt;/b&gt;&lt;br&gt;One recipient; defined portion or scope&lt;br&gt;One portion cannot be assigned twice" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#f5f8ff;strokeColor=#5677a5;" vertex="1" parent="1"><mxGeometry x="40" y="720" width="340" height="150" as="geometry" /></mxCell><mxCell id="Outcome" value="&lt;b&gt;Outcome&lt;/b&gt;&lt;br&gt;Recipient report; coordinator reviews&lt;br&gt;Accepted partial is not full completion" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#f5f8ff;strokeColor=#5677a5;" vertex="1" parent="1"><mxGeometry x="530" y="720" width="340" height="150" as="geometry" /></mxCell><mxCell id="EvidenceAttachment" value="&lt;b&gt;EvidenceAttachment&lt;/b&gt;&lt;br&gt;Supports reported delivery and receipt&lt;br&gt;One or more required on submission" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#f5f8ff;strokeColor=#5677a5;" vertex="1" parent="1"><mxGeometry x="1020" y="720" width="340" height="150" as="geometry" /></mxCell><mxCell id="DecisionHistory" value="&lt;b&gt;DecisionHistory&lt;/b&gt;&lt;br&gt;Actor, action, time and reason&lt;br&gt;Exactly one request or referral subject" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#f5f8ff;strokeColor=#5677a5;" vertex="1" parent="1"><mxGeometry x="1510" y="720" width="340" height="150" as="geometry" /></mxCell><mxCell id="RecipientDecision" value="&lt;b&gt;RecipientDecision&lt;/b&gt;&lt;br&gt;Application review record&lt;br&gt;Phase 1 target: coordinator decision" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#f5f8ff;strokeColor=#5677a5;" vertex="1" parent="1"><mxGeometry x="40" y="1020" width="340" height="150" as="geometry" /></mxCell><mxCell id="Confirmation" value="&lt;b&gt;Confirmation&lt;/b&gt;&lt;br&gt;Optional separate confirmation / disagreement" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#f5f8ff;strokeColor=#5677a5;" vertex="1" parent="1"><mxGeometry x="530" y="1020" width="340" height="150" as="geometry" /></mxCell><mxCell id="ReferralRelease" value="&lt;b&gt;ReferralRelease&lt;/b&gt;&lt;br&gt;Explicitly frees undelivered portion" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#f5f8ff;strokeColor=#5677a5;" vertex="1" parent="1"><mxGeometry x="1020" y="1020" width="340" height="150" as="geometry" /></mxCell><mxCell id="OutcomeReview" value="&lt;b&gt;OutcomeReview&lt;/b&gt;&lt;br&gt;Coordinator decision; not independent proof" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#f5f8ff;strokeColor=#5677a5;" vertex="1" parent="1"><mxGeometry x="1510" y="1020" width="340" height="150" as="geometry" /></mxCell><mxCell id="edge0" value="many : many" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" source="UserAccount" target="Role" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge1" value="0..1 : 0..1" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" source="UserAccount" target="Beneficiary" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge2" value="many : many membership" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" source="UserAccount" target="ReferralRecipient" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge3" value="total, disjoint subtype" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" source="ReferralRecipient" target="Charity" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge4" value="total, disjoint subtype" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" source="ReferralRecipient" target="Contributor" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge5" value="1 : 0..*" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" source="ReferralRecipient" target="RecipientDecision" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge6" value="1 : 0..*" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" source="Beneficiary" target="AssistanceRequest" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge7" value="1 : 0..* submits" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" source="UserAccount" target="AssistanceRequest" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge8" value="parent 1 : 0..*" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" source="AssistanceRequest" target="RequestLink" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge9" value="child 1 : 0..1" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" source="AssistanceRequest" target="RequestLink" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge10" value="1 : 0..*" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" source="AssistanceRequest" target="Referral" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge11" value="1 : 0..*" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" source="ReferralRecipient" target="Referral" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge12" value="1 : 0..*" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" source="Referral" target="Outcome" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge13" value="1 : 0..* draft; 1+ submitted" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" source="Outcome" target="EvidenceAttachment" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge14" value="1 : 0..*" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" source="Outcome" target="OutcomeReview" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge15" value="1 : 0..*" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" source="Referral" target="ReferralRelease" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge16" value="1 : 0..*" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" source="Referral" target="Confirmation" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge17" value="0..1 : 0..*" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" source="AssistanceRequest" target="DecisionHistory" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge18" value="0..1 : 0..*" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" source="Referral" target="DecisionHistory" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="OutcomeDispute" value="&lt;b&gt;OutcomeDispute&lt;/b&gt;&lt;br&gt;One outcome; history retained&lt;br&gt;One open dispute per outcome&lt;br&gt;Open dispute freezes request transitions" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#f5f8ff;strokeColor=#5677a5;" vertex="1" parent="1"><mxGeometry x="40" y="1320" width="340" height="150" as="geometry" /></mxCell><mxCell id="OutcomeAdjustment" value="&lt;b&gt;OutcomeAdjustment&lt;/b&gt;&lt;br&gt;Audited correction to an accepted outcome&lt;br&gt;Corrected amount remains between zero and original&lt;br&gt;Request balances are rechecked" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#f5f8ff;strokeColor=#5677a5;" vertex="1" parent="1"><mxGeometry x="530" y="1320" width="340" height="150" as="geometry" /></mxCell><mxCell id="newedge0" value="1 : 0..*" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" source="Outcome" target="OutcomeDispute" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="newedge1" value="1 : 0..*" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" source="Outcome" target="OutcomeAdjustment" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="newedge2" value="raises; optionally resolves" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" source="UserAccount" target="OutcomeDispute" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="newedge3" value="coordinator records" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" source="UserAccount" target="OutcomeAdjustment" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p1_concept_header" value="Phase 1 extensions - conceptual proposal only&lt;br&gt;&lt;span style=&quot;font-size:12px;font-weight:normal&quot;&gt;Dashed shapes and arrows show required business concepts and relationships, not tables, keys or confirmed cardinalities.&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=8;fontSize=15;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="1530" width="1900" height="72" as="geometry" /></mxCell><mxCell id="p1_category" value="&lt;b&gt;Service category and versions&lt;/b&gt;&lt;br&gt;Managed by coordinators" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=12;dashed=1;fillColor=#fff9e6;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="1640" width="340" height="150" as="geometry" /></mxCell><mxCell id="p1_standard" value="&lt;b&gt;Standard version and components&lt;/b&gt;&lt;br&gt;Named quantities and units&lt;br&gt;History retains the recorded version" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=12;dashed=1;fillColor=#fff9e6;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="430" y="1640" width="340" height="150" as="geometry" /></mxCell><mxCell id="p1_need" value="&lt;b&gt;Separately tracked need&lt;/b&gt;&lt;br&gt;Recorded service and standard version&lt;br&gt;Outstanding needs use exact-version matches" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=12;dashed=1;fillColor=#fff9e6;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="820" y="1640" width="340" height="150" as="geometry" /></mxCell><mxCell id="p1_assignment" value="&lt;b&gt;Referral portion&lt;/b&gt;&lt;br&gt;Part or all of one need&lt;br&gt;No capacity or need over-allocation" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=12;dashed=1;fillColor=#fff9e6;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1210" y="1640" width="340" height="150" as="geometry" /></mxCell><mxCell id="p1_charity" value="&lt;b&gt;Approved active charity&lt;/b&gt;&lt;br&gt;Only eligible recipients receive referrals" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=12;dashed=1;fillColor=#fff9e6;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1600" y="1640" width="340" height="150" as="geometry" /></mxCell><mxCell id="p1_request" value="&lt;b&gt;Beneficiary request&lt;/b&gt;&lt;br&gt;Self-submitted in Phase 1&lt;br&gt;One or more needs" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=12;dashed=1;fillColor=#fff9e6;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="430" y="1870" width="340" height="150" as="geometry" /></mxCell><mxCell id="p1_capacity" value="&lt;b&gt;Supported service and capacity&lt;/b&gt;&lt;br&gt;Cairo-day available-from-now units&lt;br&gt;Stale version freezes new assignment" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=12;dashed=1;fillColor=#fff9e6;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1210" y="1870" width="340" height="150" as="geometry" /></mxCell><mxCell id="p1_reminder" value="&lt;b&gt;Daily reminder intent&lt;/b&gt;&lt;br&gt;One per charity/Cairo day&lt;br&gt;Attempt state; delivery not guaranteed" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=12;dashed=1;fillColor=#fff9e6;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1600" y="1870" width="340" height="150" as="geometry" /></mxCell><mxCell id="p1_e1" value="defines" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=block;endFill=1;strokeColor=#b47720;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" source="p1_category" target="p1_standard" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p1_e2" value="used by" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=block;endFill=1;strokeColor=#b47720;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" source="p1_standard" target="p1_need" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p1_e3" value="allocated as" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=block;endFill=1;strokeColor=#b47720;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" source="p1_need" target="p1_assignment" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p1_e4" value="assigned to" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=block;endFill=1;strokeColor=#b47720;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" source="p1_assignment" target="p1_charity" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p1_e5" value="contains" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=block;endFill=1;strokeColor=#b47720;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" source="p1_request" target="p1_need" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p1_e6" value="limits" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=block;endFill=1;strokeColor=#b47720;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" source="p1_capacity" target="p1_assignment" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p1_e7" value="reports" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=block;endFill=1;strokeColor=#b47720;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" source="p1_charity" target="p1_capacity" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p1_e8" value="receives" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=block;endFill=1;strokeColor=#b47720;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" source="p1_charity" target="p1_reminder" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel>