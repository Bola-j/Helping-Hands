        <mxCell id="newedge1" value="1 : 0..* actor" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" source="UserAccount" target="OutcomeAdjustment" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="newedge2" value="1 : 0..*" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" source="Outcome" target="OutcomeDispute" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="newedge3" value="1 : 0..* raises" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" source="UserAccount" target="OutcomeDispute" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="newedge4" value="0..1 : 0..* resolves" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" source="UserAccount" target="OutcomeDispute" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Constraints" value="&lt;b&gt;Constraints&lt;/b&gt;&lt;br&gt;Intake / split parent: Category, quantity and unit may be null.&lt;br&gt;Allocatable request: one category, quantity &gt; 0, nonblank unit.&lt;br&gt;Adjustment: nonzero, audited, corrected accepted amount between 0 and original.&lt;br&gt;Dispute: resolution fields all null or all present; one open per outcome.&lt;br&gt;Open dispute freezes allocation, acceptance, release and completion.&lt;br&gt;See database-design.md for transactional invariants and all constraints." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#f5f8ff;strokeColor=#5677a5;" vertex="1" parent="1">
          <mxGeometry x="530" y="1620" width="340" height="240" as="geometry" />
        </mxCell>
        <mxCell id="RequestDispute" value="&lt;b&gt;RequestDispute&lt;/b&gt;&lt;br&gt;RequestDisputeId uuid PK&lt;br&gt;RequestId uuid! FK AssistanceRequest&lt;br&gt;ConfirmationId uuid! FK Confirmation&lt;br&gt;Details varchar(2000)!&lt;br&gt;RaisedByUserId uuid! FK UserAccount&lt;br&gt;RaisedAt timestamptz!&lt;br&gt;ResolvedByUserId uuid? FK UserAccount&lt;br&gt;Resolution varchar(2000)?&lt;br&gt;ResolvedAt timestamptz?" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#f5f8ff;strokeColor=#5677a5;" vertex="1" parent="1">
          <mxGeometry x="1020" y="1620" width="340" height="240" as="geometry" />
        </mxCell>
        <mxCell id="ConfirmationOutcomeDispute" value="&lt;b&gt;ConfirmationOutcomeDispute&lt;/b&gt;&lt;br&gt;ConfirmationOutcomeDisputeId uuid PK&lt;br&gt;ConfirmationId uuid! FK Confirmation&lt;br&gt;DisputeId uuid! FK OutcomeDispute" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#f5f8ff;strokeColor=#5677a5;" vertex="1" parent="1">
          <mxGeometry x="1510" y="1620" width="340" height="240" as="geometry" />
        </mxCell>
        <mxCell id="disputeEdge0" value="1 : 0..*" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" source="AssistanceRequest" target="RequestDispute" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="disputeEdge1" value="1 : 0..* source" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" source="Confirmation" target="RequestDispute" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="disputeEdge2" value="1 : 0..* raises" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" source="UserAccount" target="RequestDispute" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="disputeEdge3" value="0..1 : 0..* resolves" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" source="UserAccount" target="RequestDispute" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="disputeEdge4" value="1 : 0..*" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" source="Confirmation" target="ConfirmationOutcomeDispute" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="disputeEdge5" value="1 : 0..*" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" source="OutcomeDispute" target="ConfirmationOutcomeDispute" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1_rel_header" value="Phase 1 relational extensions - not yet designed or migrated&lt;br&gt;&lt;span style=&quot;font-size:12px;font-weight:normal&quot;&gt;The earlier tables above are a design proposal; the current migration covers a subset. The boxes below are design requirements, not table definitions or new confirmed PK/FK mappings.&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=8;fontSize=15;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="40" y="1910" width="1900" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p1_rel_versions" value="&lt;b&gt;Catalog and version history&lt;/b&gt;&lt;br&gt;Service categories, versioned standards and structured components need reviewed mapping.&lt;br&gt;UUID keys and immutable recorded versions; no invented field or relationship layout." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=12;dashed=1;fillColor=#fff9e6;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="40" y="2030" width="340" height="200" as="geometry" />
        </mxCell>
        <mxCell id="p1_rel_capacity" value="&lt;b&gt;Charity services and daily capacity&lt;/b&gt;&lt;br&gt;Track supported service/version and available-from-now values for the Cairo day.&lt;br&gt;Zero differs from stale; shared locking must protect allocation and updates." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=12;dashed=1;fillColor=#fff9e6;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="530" y="2030" width="340" height="200" as="geometry" />
        </mxCell>
        <mxCell id="p1_rel_needs" value="&lt;b&gt;Requests and separately tracked needs&lt;/b&gt;&lt;br&gt;Record each need, standard version and referral portions without double counting.&lt;br&gt;Earlier RequestLink is a candidate, not a chosen Phase 1 mapping." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=12;dashed=1;fillColor=#fff9e6;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1020" y="2030" width="340" height="200" as="geometry" />
        </mxCell>
        <mxCell id="p1_rel_reminders" value="&lt;b&gt;Reminder state&lt;/b&gt;&lt;br&gt;One reminder intent per charity/Cairo day with attempt history and safe retry handling.&lt;br&gt;SMTP acceptance is not proof of delivery." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=12;dashed=1;fillColor=#fff9e6;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1510" y="2030" width="340" height="200" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
