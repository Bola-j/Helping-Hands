<?xml version='1.0' encoding='utf-8'?>
<mxGraphModel adaptiveColors="auto" page="1" pageScale="1" pageWidth="2100" pageHeight="2100" grid="1" gridSize="10"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b&gt;Helping Hands — conceptual EER&lt;/b&gt;&lt;br&gt;Proposed domain model; numbers show relationship cardinalities. Recipient subtypes are total and disjoint." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1900" height="65" as="geometry" /></mxCell><mxCell id="UserAccount" value="&lt;b&gt;UserAccount&lt;/b&gt;&lt;br&gt;May hold multiple roles&lt;br&gt;Can represent recipients&lt;br&gt;Can submit requests" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#f5f8ff;strokeColor=#5677a5;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="340" height="150" as="geometry" /></mxCell><mxCell id="Role" value="&lt;b&gt;Role&lt;/b&gt;&lt;br&gt;Administrator / Coordinator&lt;br&gt;Requester / Recipient representative" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#f5f8ff;strokeColor=#5677a5;" vertex="1" parent="1"><mxGeometry x="530" y="120" width="340" height="150" as="geometry" /></mxCell><mxCell id="Beneficiary" value="&lt;b&gt;Beneficiary&lt;/b&gt;&lt;br&gt;Person or family&lt;br&gt;May have no account" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#f5f8ff;strokeColor=#5677a5;" vertex="1" parent="1"><mxGeometry x="1020" y="120" width="340" height="150" as="geometry" /></mxCell><mxCell id="ReferralRecipient" value="&lt;b&gt;ReferralRecipient&lt;/b&gt;&lt;br&gt;Approved and active before referral&lt;br&gt;Exactly one subtype: Charity or Contributor" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#f5f8ff;strokeColor=#5677a5;" vertex="1" parent="1"><mxGeometry x="1510" y="120" width="340" height="150" as="geometry" /></mxCell><mxCell id="Charity" value="&lt;b&gt;Charity&lt;/b&gt;&lt;br&gt;Organization and registration details" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#f5f8ff;strokeColor=#5677a5;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="340" height="150" as="geometry" /></mxCell><mxCell id="Contributor" value="&lt;b&gt;Contributor&lt;/b&gt;&lt;br&gt;Individual contributor" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#f5f8ff;strokeColor=#5677a5;" vertex="1" parent="1"><mxGeometry x="530" y="420" width="340" height="150" as="geometry" /></mxCell><mxCell id="AssistanceRequest" value="&lt;b&gt;AssistanceRequest&lt;/b&gt;&lt;br&gt;One beneficiary; one submitter&lt;br&gt;Intake may be unclassified or mixed&lt;br&gt;Category, quantity and unit may be absent until allocatable&lt;br&gt;Split parent is non-allocatable" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#f5f8ff;strokeColor=#5677a5;" vertex="1" parent="1"><mxGeometry x="1020" y="420" width="340" height="150" as="geometry" /></mxCell><mxCell id="RequestLink" value="&lt;b&gt;RequestLink&lt;/b&gt;&lt;br&gt;Links split parent and child&lt;br&gt;Child has at most one parent" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#f5f8ff;strokeColor=#5677a5;" vertex="1" parent="1"><mxGeometry x="1510" y="420" width="340" height="150" as="geometry" /></mxCell><mxCell id="Referral" value="&lt;b&gt;Referral&lt;/b&gt;&lt;br&gt;One recipient; defined portion or scope&lt;br&gt;One portion cannot be assigned twice" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#f5f8ff;strokeColor=#5677a5;" vertex="1" parent="1"><mxGeometry x="40" y="720" width="340" height="150" as="geometry" /></mxCell><mxCell id="Outcome" value="&lt;b&gt;Outcome&lt;/b&gt;&lt;br&gt;Recipient report; coordinator reviews&lt;br&gt;Accepted partial is not full completion" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#f5f8ff;strokeColor=#5677a5;" vertex="1" parent="1"><mxGeometry x="530" y="720" width="340" height="150" as="geometry" /></mxCell><mxCell id="EvidenceAttachment" value="&lt;b&gt;EvidenceAttachment&lt;/b&gt;&lt;br&gt;Supports reported delivery and receipt&lt;br&gt;One or more required on submission" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#f5f8ff;strokeColor=#5677a5;" vertex="1" parent="1"><mxGeometry x="1020" y="720" width="340" height="150" as="geometry" /></mxCell><mxCell id="DecisionHistory" value="&lt;b&gt;DecisionHistory&lt;/b&gt;&lt;br&gt;Actor, action, time and reason&lt;br&gt;Exactly one request or referral subject" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#f5f8ff;strokeColor=#5677a5;" vertex="1" parent="1"><mxGeometry x="1510" y="720" width="340" height="150" as="geometry" /></mxCell><mxCell id="RecipientDecision" value="&lt;b&gt;RecipientDecision&lt;/b&gt;&lt;br&gt;Application review record" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#f5f8ff;strokeColor=#5677a5;" vertex="1" parent="1"><mxGeometry x="40" y="1020" width="340" height="150" as="geometry" /></mxCell><mxCell id="Confirmation" value="&lt;b&gt;Confirmation&lt;/b&gt;&lt;br&gt;Optional separate confirmation / disagreement" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#f5f8ff;strokeColor=#5677a5;" vertex="1" parent="1"><mxGeometry x="530" y="1020" width="340" height="150" as="geometry" /></mxCell><mxCell id="ReferralRelease" value="&lt;b&gt;ReferralRelease&lt;/b&gt;&lt;br&gt;Explicitly frees undelivered portion" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#f5f8ff;strokeColor=#5677a5;" vertex="1" parent="1"><mxGeometry x="1020" y="1020" width="340" height="150" as="geometry" /></mxCell><mxCell id="OutcomeReview" value="&lt;b&gt;OutcomeReview&lt;/b&gt;&lt;br&gt;Coordinator decision; not independent proof" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#f5f8ff;strokeColor=#5677a5;" vertex="1" parent="1"><mxGeometry x="1510" y="1020" width="340" height="150" as="geometry" /></mxCell><mxCell id="edge0" value="many : many" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" source="UserAccount" target="Role" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge1" value="0..1 : 0..1" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" source="UserAccount" target="Beneficiary" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge2" value="many : many membership" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" source="UserAccount" target="ReferralRecipient" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge3" value="total, disjoint subtype" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" source="ReferralRecipient" target="Charity" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge4" value="total, disjoint subtype" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" source="ReferralRecipient" target="Contributor" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge5" value="1 : 0..*" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" source="ReferralRecipient" target="RecipientDecision" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge6" value="1 : 0..*" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" source="Beneficiary" target="AssistanceRequest" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge7" value="1 : 0..* submits" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" source="UserAccount" target="AssistanceRequest" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge8" value="parent 1 : 0..*" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" source="AssistanceRequest" target="RequestLink" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge9" value="child 1 : 0..1" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" source="AssistanceRequest" target="RequestLink" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge10" value="1 : 0..*" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" source="AssistanceRequest" target="Referral" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge11" value="1 : 0..*" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" source="ReferralRecipient" target="Referral" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge12" value="1 : 0..*" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" source="Referral" target="Outcome" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge13" value="1 : 0..* draft; 1+ submitted" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" source="Outcome" target="EvidenceAttachment" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge14" value="1 : 0..*" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" source="Outcome" target="OutcomeReview" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge15" value="1 : 0..*" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" source="Referral" target="ReferralRelease" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge16" value="1 : 0..*" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" source="Referral" target="Confirmation" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge17" value="0..1 : 0..*" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" source="AssistanceRequest" target="DecisionHistory" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge18" value="0..1 : 0..*" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" source="Referral" target="DecisionHistory" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="OutcomeDispute" value="&lt;b&gt;OutcomeDispute&lt;/b&gt;&lt;br&gt;One outcome; history retained&lt;br&gt;One open dispute per outcome&lt;br&gt;Open dispute freezes request transitions" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#f5f8ff;strokeColor=#5677a5;" vertex="1" parent="1"><mxGeometry x="40" y="1320" width="340" height="150" as="geometry" /></mxCell><mxCell id="OutcomeAdjustment" value="&lt;b&gt;OutcomeAdjustment&lt;/b&gt;&lt;br&gt;Audited correction to an accepted outcome&lt;br&gt;Corrected amount remains between zero and original&lt;br&gt;Request balances are rechecked" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#f5f8ff;strokeColor=#5677a5;" vertex="1" parent="1"><mxGeometry x="530" y="1320" width="340" height="150" as="geometry" /></mxCell><mxCell id="newedge0" value="1 : 0..*" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" source="Outcome" target="OutcomeDispute" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="newedge1" value="1 : 0..*" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" source="Outcome" target="OutcomeAdjustment" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="newedge2" value="raises; optionally resolves" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" source="UserAccount" target="OutcomeDispute" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="newedge3" value="coordinator records" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" source="UserAccount" target="OutcomeAdjustment" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel>