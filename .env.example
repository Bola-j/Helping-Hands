# Copy to .env and edit locally. Values are plain, unquoted KEY=VALUE pairs.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=https://localhost:5087
# Development-only placeholders: choose your own local credentials before starting Compose.
# Optional database user; keep host connection Username in sync when changed.
POSTGRES_USER=helping_hands
POSTGRES_PASSWORD=replace-with-local-password
S3_ACCESS_KEY=replacewithlocaluser
S3_SECRET_KEY=replacewithlocalpassword
EVIDENCE_BUCKET=helping-hands-evidence
# Local SMTP catcher (Mailpit) credentials and host connection settings.
SMTP_USER=local-smtp-user
SMTP_PASSWORD=replace-with-local-smtp-password
SMTP_FROM_ADDRESS=noreply@helping-hands.example.test
SMTP_USE_SSL=false
SMTP_MAX_MESSAGES=500
# Optional loopback ports for an isolated Compose project. Keep host connection values below in sync.
API_HOST_PORT=8443
POSTGRES_HOST_PORT=55432
S3_API_HOST_PORT=9000
SMTP_HOST_PORT=1025
SMTP_UI_HOST_PORT=8025
# S3 credentials must contain only ASCII letters and digits.
# The connection, object-store, and SMTP credentials must match the Compose settings above.
ConnectionStrings__HelpingHands=Host=localhost;Port=55432;Database=helping_hands;Username=helping_hands;Password=replace-with-local-password
EvidenceStorage__ServiceUrl=http://localhost:9000
EvidenceStorage__Bucket=helping-hands-evidence
EvidenceStorage__AccessKey=replacewithlocaluser
EvidenceStorage__SecretKey=replacewithlocalpassword
Smtp__Host=localhost
Smtp__Port=1025
Smtp__Username=local-smtp-user
Smtp__Password=replace-with-local-smtp-password
Smtp__FromAddress=noreply@helping-hands.example.test
Smtp__UseSsl=false
# Required only when running the explicit development-only -SeedDemo command.
# DemoSeed__AdminEmail=admin@example.test
# DemoSeed__AdminPassword=replace-with-local-strong-password
# DemoSeed__CoordinatorEmail=coordinator@example.test
# DemoSeed__CoordinatorPassword=replace-with-another-local-strong-password

# Password for the local HTTPS certificate mounted into the API container.
DEV_CERT_PASSWORD=replace-with-local-certificate-password