        <mxCell id="note" value="Shared constraints: normalized email is unique across both signup routes; invalid input, duplicate email, failed related writes, or invalid antiforgery returns a safe error and leaves no partial account/profile/application. Login is separate (P1-10). `Beneficiary` is a seeded role value, not a new table or migration." style="shape=note;whiteSpace=wrap;html=1;size=18;align=left;verticalAlign=middle;spacing=10;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="150" y="770" width="1140" height="105" as="geometry"/></mxCell>
