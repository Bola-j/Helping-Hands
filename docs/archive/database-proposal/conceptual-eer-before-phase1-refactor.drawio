        <mxCell id="title" value="&lt;b&gt;Helping Hands - conceptual EER&lt;/b&gt;&lt;br&gt;Earlier proposed core model; existing implementation covers only a subset. Phase 1 extensions below are proposed, not an implemented or final schema." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1900" height="65" as="geometry" />
        </mxCell>
        <mxCell id="UserAccount" value="&lt;b&gt;UserAccount&lt;/b&gt;&lt;br&gt;May hold multiple roles&lt;br&gt;Can represent recipients&lt;br&gt;Can submit requests" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#f5f8ff;strokeColor=#5677a5;" vertex="1" parent="1">
